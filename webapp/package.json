{
  "name": "pico-gnss-webapp",
  "private": true,
  "version": "0.2.0",
  "description": "Real-time GNSS dashboard for pico-gnss (probe-rs RTT bridge, React + Vite)",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "tsc -p tsconfig.web.json --noEmit && vite build",
    "build": "pnpm run build:server && pnpm run build:web",
    "start": "node dist/server.js",
    "replay": "node dist/server.js --replay sample.log",
    "dev": "pnpm run build && pnpm run start"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
